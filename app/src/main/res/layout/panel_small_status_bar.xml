<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	style="@style/TTheme.MainSmall.StatusBar.Wrapper"
	android:id="@+id/tray_wrapper"
	android:orientation="horizontal"
	android:gravity="center_vertical"
	android:defaultFocusHighlightEnabled="false"
	android:focusable="false"
	android:focusableInTouchMode="false">

	<!-- Sidephone: the strip holds only the suggestions (or the status text when there are none).
	     It is shown while a word or the symbol grid is being composed and collapses to nothing
	     otherwise, so it carries no buttons. Settings is on the launcher icon; the language and the
	     input mode are on the arrows key. See MainLayoutTray.applyCollapse(). -->
	<FrameLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1">
		<include layout="@layout/panel_status_bar" />
	</FrameLayout>

</LinearLayout>
